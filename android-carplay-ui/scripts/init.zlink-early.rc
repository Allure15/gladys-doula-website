# Install to /vendor/etc/init/ (or /system/etc/init/) and the script to /system/bin/. Needs root/remount.
service zlink_early /system/bin/sh /system/bin/early-zlink.sh
    class late_start
    user root
    oneshot
    seclabel u:r:su:s0

on boot
    start zlink_early
    # serial node used by the CAN sniffer (adjust to the MCU/ESP32 port):
    chmod 0666 /dev/ttyS1
